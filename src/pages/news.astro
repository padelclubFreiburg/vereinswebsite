---
import { getCollection } from "astro:content";
import { Picture } from "astro:assets";
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";
import { getFormattedDate } from "@/utils/all";

// Nur veröffentlichte Beiträge (draft: false, Datum in der Vergangenheit), neueste zuerst
const publishedBlogEntries = await getCollection("blog", ({ data }) => {
  return !data.draft && data.publishDate < new Date();
});
publishedBlogEntries.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
---

<Layout title="News & Events" description="Neuigkeiten, Turniere und Events des Padel Club Freiburg e.V.">
  <Container>
    <Sectionhead>
      <Fragment slot="title">News &amp; Events</Fragment>
      <Fragment slot="desc">
        Bleib hier oder auf
        <a href="https://www.instagram.com/padelclubfreiburg" target="_blank" rel="noopener" class="text-primary-dark underline hover:no-underline">Instagram</a>
        auf dem Laufenden.
      </Fragment>
    </Sectionhead>

    <ul class="mx-auto mt-12 grid max-w-[56rem] gap-12 lg:gap-16">
      {
        publishedBlogEntries.map((blogPostEntry, index) => (
          <li>
            <a href={`/blog/${blogPostEntry.slug}`} class="group grid items-center gap-5 rounded-lg md:grid-cols-2 md:gap-10">
              <Picture
                src={blogPostEntry.data.image.src}
                alt={blogPostEntry.data.image.alt}
                sizes="(max-width: 800px) 100vw, 800px"
                width={800}
                height={600}
                loading={index <= 2 ? "eager" : "lazy"}
                decoding={index <= 2 ? "sync" : "async"}
                class="w-full rounded-lg bg-neutrallight object-cover object-center"
              />
              <div>
                <span class="inline-block rounded-sm bg-primary-tint px-3 py-1 text-sm leading-5 font-semibold text-primary-dark">
                  {blogPostEntry.data.category}
                </span>
                <h2 class="mt-3 text-2xl leading-tight font-bold tracking-tight group-hover:text-primary-dark group-hover:underline">
                  {blogPostEntry.data.title.trim()}
                </h2>
                <p class="mt-3 text-base text-text-muted">
                  {blogPostEntry.data.author} ·{" "}
                  <time datetime={blogPostEntry.data.publishDate.toISOString()}>
                    {getFormattedDate(blogPostEntry.data.publishDate)}
                  </time>
                </p>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </Container>
</Layout>
