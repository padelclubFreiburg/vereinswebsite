---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";
---

<Layout title="Impressum">
  <Container>
    <Sectionhead>
      <Fragment slot="title">Impressum</Fragment>
      <Fragment slot="desc">Angaben zum Padel Club Freiburg e.V.
      </Fragment>
    </Sectionhead>

    <div class="mx-auto mt-12 flex max-w-[48rem] flex-col gap-3 wrap-anywhere">
        <h2 class="mt-6 text-2xl leading-tight font-bold tracking-tight">Impressum</h2>
        <p class="type-body">
            Angaben gemäß § 5 TMG und § 18 MStV
        </p>

        <h2 class="mt-6 text-2xl leading-tight font-bold tracking-tight">Betreiber der Website</h2>
        <p class="type-body">
            Padel Club Freiburg e.V.<br>
            Habsburger Straße 110<br>
            79104 Freiburg im Breisgau<br>
            Deutschland
        </p>

        <h2 class="mt-6 text-2xl leading-tight font-bold tracking-tight">Vertretungsberechtigte</h2>
        <p class="type-body">
            Dino Saggiomo, Präsident<br>
            Enzio Maggiore, Vize-Präsident<br>
            Jana Koppermann, Vorstand Finanzen und Mitgliederwesen
        </p>

        <h2 class="mt-6 text-2xl leading-tight font-bold tracking-tight">Vereinsregister</h2>
        <p class="type-body">
            Eingetragen im Vereinsregister<br>
            Registergericht: Amtsgericht Freiburg im Breisgau<br>
            Vereinsregisternummer: VR 704876
        </p>

        <h2 class="mt-6 text-2xl leading-tight font-bold tracking-tight">Kontakt</h2>
        <p class="type-body">
            Telefon: +49 179 3934890<br>
            E-Mail: <a href="mailto:info@padelclub-freiburg.de" class="text-primary-dark underline hover:no-underline">info@padelclub-freiburg.de</a><br>
            Online-Kontaktformular: 
            <a href="https://www.padelclub-freiburg.de/contact/" class="text-primary-dark underline hover:no-underline">
            https://www.padelclub-freiburg.de/contact/
            </a>
        </p>

        <h2 class="mt-6 text-2xl leading-tight font-bold tracking-tight">Umsatzsteuer-ID</h2>
        <p class="type-body">
            Umsatzsteuer-Identifikationsnummer gemäß § 27a Umsatzsteuergesetz:<br>
            [Platzhalter – wird ergänzt]
        </p>

        <h2 class="mt-6 text-2xl leading-tight font-bold tracking-tight">Inhaltlich verantwortlich gemäß § 18 Abs. 2 MStV</h2>
        <p class="type-body">
            Dino Saggiomo<br>
            Habsburger Straße 110<br>
            79104 Freiburg im Breisgau
        </p>

        <h2 class="mt-6 text-2xl leading-tight font-bold tracking-tight">Soziale Medien</h2>
        <p class="type-body">
            Dieses Impressum gilt auch für folgende Onlinepräsenzen:<br>
            Instagram: 
            <a href="https://www.instagram.com/padelclubfreiburg" class="text-primary-dark underline hover:no-underline">
            https://www.instagram.com/padelclubfreiburg
            </a>
        </p> 
    </div>
</Container>
</Layout>