---
import Container from "@/components/container.astro";
import Layout from "@/layouts/Layout.astro";
import Link from "@/components/ui/link.astro";
---

<Layout title="Seite nicht gefunden">
  <Container>
    <div class="flex min-h-[calc(100vh-24rem)] flex-col items-center justify-center pt-16 text-center">
      <p class="type-hero">404</p>
      <h1 class="type-h2 mt-4">Seite nicht gefunden</h1>
      <p class="type-body mt-4 max-w-[48ch]">
        Diese Seite gibt es nicht (mehr). Vielleicht hilft dir die Startseite oder unsere Sammlung häufiger Fragen weiter.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <Link href="/">Zur Startseite</Link>
        <Link href="/faq" variant="secondary">Häufige Fragen</Link>
      </div>
    </div>
  </Container>
</Layout>
