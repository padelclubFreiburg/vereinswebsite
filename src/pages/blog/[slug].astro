---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import Link from "@/components/ui/link.astro";
import { getFormattedDate } from "@/utils/all";

// Nur veröffentlichte Beiträge bekommen eine Seite (wie in der News-Übersicht)
export async function getStaticPaths() {
  const blogEntries = await getCollection("blog", ({ data }) => !data.draft && data.publishDate < new Date());
  return blogEntries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const title = entry.data.title.trim();
---

<Layout title={title}>
  <Container>
    <article class="mx-auto max-w-3xl pt-12 lg:pt-16">
      <span class="inline-block rounded-sm bg-primary-tint px-3 py-1 text-sm leading-5 font-semibold text-primary-dark">
        {entry.data.category}
      </span>
      <h1 class="mt-3 text-[2rem] leading-tight font-bold tracking-[-0.025em] lg:text-5xl">{title}</h1>
      <p class="mt-3 flex flex-wrap items-center gap-x-2 text-base text-text-muted">
        <span>{entry.data.author}</span>
        <span aria-hidden="true">·</span>
        <time datetime={entry.data.publishDate.toISOString()}>{getFormattedDate(entry.data.publishDate)}</time>
      </p>

      <div class="prose prose-lg mt-8 max-w-none">
        <Content />
      </div>

      <div class="mt-12">
        <Link href="/news" variant="secondary">
          <Icon name="lucide:arrow-left" class="icon-stroke size-5" aria-hidden="true" />
          Alle News &amp; Events
        </Link>
      </div>
    </article>
  </Container>
</Layout>
