---
import Link from "./ui/link.astro";
import CourtLines from "./court-lines.astro";
---

<section
  class="on-dark relative overflow-hidden rounded-lg bg-neutraldark px-6 py-14 text-white sm:px-10 lg:px-14 lg:py-16"
  aria-labelledby="cta-title">
  <CourtLines class="pointer-events-none absolute top-1/2 -right-1/3 w-[120%] -translate-y-1/2 opacity-50 sm:-right-6 sm:w-[55%] sm:opacity-100" />
  <div class="relative max-w-[32rem]">
    <h2 id="cta-title" class="type-banner">Werde jetzt Mitglied!</h2>
    <p class="mt-4 text-lg leading-7 text-border">
      Wähle deine passende Mitgliedschaft und stell deinen Antrag direkt online.
    </p>
    <div class="mt-8">
      <Link href="/mitgliedschaft" variant="signal">Mitgliedschaft wählen</Link>
    </div>
  </div>
</section>
