---
// Zwei Boxen nebeneinander: Mitglied werden (dunkel, Neon-Button) und PCF Liga (Lavendel).
import { Icon } from "astro-icon/components";
import Link from "./ui/link.astro";
import CourtLines from "./court-lines.astro";
import { Image } from "astro:assets";
import { LIGA_URL } from "@/lib/liga";
// Auf Lavendel nur die einfarbige Anthrazit-Variante des Liga-Logos (CI-Guide 10.2)
import ligaLogo from "@/assets/logos/liga/pcf-liga-monogramm-einfarbig-anthrazit.svg";

// Eckdaten der Liga (Quelle: liga.padelclub-freiburg.de) – bei Änderungen dort hier mitpflegen
const ligaFakten = [
  "Teams aus 2 Personen",
  "4 Leistungsstufen mit Auf- und Abstieg",
  "3 Spiele pro Quartal, gebucht über Playtomic",
  "Kostenlos für Mitglieder, sonst 10 € pro Jahr",
];
---

<div class="grid gap-6 lg:grid-cols-2">
  <section
    class="on-dark relative overflow-hidden rounded-lg bg-neutraldark px-6 py-12 text-white sm:px-10 lg:py-14"
    aria-labelledby="cta-title">
    <CourtLines class="pointer-events-none absolute -right-1/3 -bottom-6 w-[110%] opacity-40 sm:-right-10 sm:w-[70%] sm:opacity-100" />
    <div class="relative max-w-[30rem]">
      <h2 id="cta-title" class="type-banner">Werde jetzt Mitglied!</h2>
      <p class="mt-4 text-lg leading-7 text-border">
        Wähle deine passende Mitgliedschaft und stell deinen Antrag direkt online.
      </p>
      <div class="mt-8">
        <Link href="/mitgliedschaft" variant="signal">Mitgliedschaft wählen</Link>
      </div>
    </div>
  </section>

  <section class="rounded-lg bg-primary px-6 py-12 text-neutraldark sm:px-10 lg:py-14" aria-labelledby="liga-title">
    <div class="flex items-start justify-between gap-6">
      <h2 id="liga-title" class="type-banner pt-2">PCF Liga</h2>
      <Image src={ligaLogo} alt="Logo der PCF Liga" class="h-24 w-auto shrink-0 sm:h-32" />
    </div>
    <p class="mt-4 text-lg leading-7">
      Die Padel-Liga des Padel Club Freiburg e.V.: Spiel regelmäßig gegen neue Gegner:innen auf deinem Niveau.
      Start am 1. Januar 2027.
    </p>
    <ul class="mt-5 grid gap-2 text-base leading-6">
      {
        ligaFakten.map((fakt) => (
          <li class="flex items-start gap-2.5">
            <Icon name="lucide:circle-check" class="icon-stroke mt-0.5 size-5 shrink-0" aria-hidden="true" />
            <span>{fakt}</span>
          </li>
        ))
      }
    </ul>
    <div class="mt-8">
      <Link href={LIGA_URL}>
        Zur PCF Liga
        <Icon name="lucide:arrow-up-right" class="icon-stroke size-5" aria-hidden="true" />
      </Link>
    </div>
  </section>
</div>
