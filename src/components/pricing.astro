---
// Karte für eine Mitgliedschaft (Card nach CI-Guide 8.2). Daten im Array `pricing` in src/pages/mitgliedschaft.astro.
import { Icon } from "astro-icon/components";
import Link from "@/components/ui/link.astro";

interface Props {
  plan: {
    name: string;
    price: string;
    features: string[];
    button: { text: string; link: string };
  };
}

const { plan } = Astro.props;
---

<article class="flex h-full flex-col rounded-lg border border-border bg-neutrallight p-6">
  <h2 class="type-h3">{plan.name}</h2>
  <p class="mt-2 flex flex-wrap items-baseline gap-x-2">
    <span class="type-big-number">{plan.price}</span>
    <span class="text-base font-semibold text-text-muted">/ Jahr</span>
  </p>
  <ul class="mt-6 grid gap-3 text-base leading-6 text-text-muted">
    {
      plan.features.map((item) => (
        <li class="flex items-start gap-3">
          <Icon name="lucide:circle-check" class="icon-stroke mt-0.5 size-5 shrink-0 text-primary-dark" aria-hidden="true" />
          <span>{item}</span>
        </li>
      ))
    }
  </ul>
  <div class="mt-auto pt-8">
    <Link href={plan.button.link} target="_blank" rel="noopener" variant="secondary" block>
      {plan.button.text}
      <span class="sr-only">: Mitgliedschaft {plan.name} (Antrag bei easyVerein, öffnet in neuem Tab)</span>
    </Link>
  </div>
</article>
