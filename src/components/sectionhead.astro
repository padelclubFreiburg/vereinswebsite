---
// Seitenkopf für Unterseiten: H1 in der Display-Schrift (CI 4.1) und Beschreibung.
const { align = "center" } = Astro.props;
---

<div class:list={["pt-12 lg:pt-16", align === "center" && "text-center"]}>
  <h1 class="type-hero max-[389px]:text-[length:calc((100vw-2rem)/6)]">
    <slot name="title">Titel</slot>
  </h1>
  <p class:list={["type-body mt-4 max-w-[60ch]", align === "center" && "mx-auto"]}>
    <slot name="desc" />
  </p>
</div>
