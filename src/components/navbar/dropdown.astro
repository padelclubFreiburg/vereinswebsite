---
import { Dropdown as DropdownContainer, DropdownItems } from "astro-navbar";
const { title, lastItem, children } = Astro.props;
---

<li class="relative">
  <DropdownContainer class="group">
    <button
      type="button"
      class="flex min-h-touch w-full items-center gap-1 rounded-sm px-3 text-base text-text-muted transition-colors hover:bg-primary-tint hover:text-neutraldark lg:w-auto">
      <span>{title}</span>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="2.5"
        stroke="currentColor"
        aria-hidden="true"
        class="mt-0.5 size-3.5 group-open:rotate-180">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5"></path>
      </svg>
    </button>
    <DropdownItems>
      <div
        class:list={[
          "z-20 w-full lg:absolute lg:w-56",
          lastItem ? "lg:right-0 origin-top-right" : "lg:left-0 origin-top-left",
        ]}>
        <div class="flex flex-col py-1 pl-3 lg:mt-1 lg:rounded-lg lg:border lg:border-border lg:bg-white lg:p-2">
          {
            children.map((item) => (
              <a
                href={item.path}
                class="flex min-h-touch items-center rounded-sm px-3 text-text-muted transition-colors hover:bg-primary-tint hover:text-neutraldark">
                {item.title}
              </a>
            ))
          }
        </div>
      </div>
    </DropdownItems>
  </DropdownContainer>
</li>
