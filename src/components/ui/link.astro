---
// Link in Button-Optik (Navigation). Für Aktionen ui/button.astro nehmen.
import { buttonBase, buttonVariants, type ButtonVariant } from "./button-styles";

interface Props {
  href: string;
  variant?: ButtonVariant;
  block?: boolean;
  class?: string;
  [x: string]: any;
}

const { href, variant = "primary", block, class: className, ...rest } = Astro.props;
---

<a
  href={href}
  {...rest}
  class:list={[buttonBase, buttonVariants[variant], block && "w-full", className]}
  ><slot /></a
>
