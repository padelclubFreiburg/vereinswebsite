---
// Echter Button für Aktionen (z. B. Formular absenden). Für Navigation ui/link.astro nehmen.
import { buttonBase, buttonVariants, type ButtonVariant } from "./button-styles";

interface Props {
  variant?: ButtonVariant;
  block?: boolean;
  class?: string;
  [x: string]: any;
}

const { variant = "primary", block, class: className, ...rest } = Astro.props;
---

<button
  {...rest}
  class:list={[
    buttonBase,
    buttonVariants[variant],
    "disabled:cursor-not-allowed disabled:opacity-50",
    block && "w-full",
    className,
  ]}
  ><slot /></button
>
