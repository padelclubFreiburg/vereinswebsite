---
import { Image } from "astro:assets";
import heroImage from "@/assets/hero.svg";
import Link from "@/components/ui/link.astro";
---

<section
  class="grid items-center gap-8 pt-8 pb-8 lg:grid-cols-[3fr_2fr] lg:gap-10 lg:pt-16 lg:pb-12"
  aria-labelledby="hero-title">
  <!-- Monogramm nur, wenn es neben dem Text Platz hat (ab lg). Darunter stünde es über der Überschrift
       und doppelt sich mit dem Logo im Header. -->
  <div class="hidden lg:order-last lg:flex lg:justify-center">
    <Image
      src={heroImage}
      alt=""
      width={420}
      height={420}
      loading="eager"
      class="w-full max-w-[22rem]"
    />
  </div>
  <div>
    <h1 id="hero-title" class="type-hero max-[389px]:text-[length:calc((100vw-2rem)/6)] lg:text-[length:min(6rem,7vw)]">
      <span class="block lg:whitespace-nowrap">Willkommen beim</span>
      <span class="block lg:whitespace-nowrap">Padel Club Freiburg</span>
    </h1>
    <p class="type-body mt-6 max-w-[56ch]">
      <strong class="font-semibold text-neutraldark">Die Heimat für Padel in Freiburg.</strong>
      Der Padel Club Freiburg e.V. ist der erste Padel-Verein im Raum Freiburg. Wir fördern den Sport vom
      Breiten- bis zum Leistungssport, mit einer starken Community für Spieler:innen jeder Spielstärke.
    </p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <Link href="/mitgliedschaft">Mitglied werden</Link>
      <Link href="/faq" variant="secondary">Häufige Fragen</Link>
    </div>
  </div>
</section>
