---
import { Image } from "astro:assets";
import Container from "@/components/container.astro";
import logo from "@/assets/logos/pcf-logo-horizontal-dunkel-transparent.png";
import { LIGA_URL } from "@/lib/liga";

const columns = [
  {
    title: "Verein",
    links: [
      { title: "Team", href: "/team" },
      { title: "Partnerschaften", href: "/#partner" },
      { title: "News & Events", href: "/news" },
      { title: "Mitgliedschaft", href: "/mitgliedschaft" },
      { title: "PCF Liga", href: LIGA_URL },
    ],
  },
  {
    title: "Hilfe",
    links: [
      { title: "Häufige Fragen", href: "/faq" },
      { title: "Kontakt", href: "/contact" },
      { title: "Instagram", href: "https://www.instagram.com/padelclubfreiburg", external: true },
    ],
  },
  {
    title: "Rechtliches",
    links: [
      { title: "Impressum", href: "/impressum" },
      { title: "Datenschutz", href: "/datenschutz" },
      { title: "PCF-Glücksrad", href: "/gluecksrad/tombola.html", external: true },
    ],
  },
];
---

<footer class="on-dark mt-24 bg-neutraldark text-border">
  <Container class="py-12">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1fr]">
      <div>
        <a href="/" class="inline-block rounded-sm" aria-label="Padel Club Freiburg e.V., zur Startseite">
          <Image src={logo} alt="" height={56} densities={[1, 2]} class="h-14 w-auto" />
        </a>
        <p class="mt-4 max-w-[30ch] text-base">Die Heimat für Padel in Freiburg.</p>
      </div>
      {
        columns.map((col) => (
          <nav aria-label={col.title}>
            <h2 class="text-base font-semibold text-white">{col.title}</h2>
            <ul class="mt-3 space-y-1">
              {col.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    {...(link.external ? { target: "_blank", rel: "noopener" } : {})}
                    class="inline-flex min-h-8 items-center rounded-sm text-border hover:text-white hover:underline">
                    {link.title}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>
    <div class="mt-10 flex flex-col gap-2 border-t border-white/15 pt-6 text-sm sm:flex-row sm:justify-between">
      <p>© {new Date().getFullYear()} Padel Club Freiburg e.V.</p>
      <p>Gemeinnütziger Verein · VR 704876, Amtsgericht Freiburg</p>
    </div>
  </Container>
</footer>
