---
import { SEO } from "astro-seo";
import Footer from "@/components/footer.astro";
import Navbar from "@/components/navbar/navbar.astro";
import "@fontsource-variable/inter/index.css";
import "@fontsource/bebas-neue/latin-400.css";
import "../styles/global.css";

export interface Props {
  // Seitentitel ohne Vereinsnamen, z. B. "Kontakt". Leer = Startseite ("Willkommen").
  title?: string;
  description?: string;
}

const SITE_NAME = "Padel Club Freiburg e.V.";
const DEFAULT_DESCRIPTION =
  "Der Padel Club Freiburg e.V. ist der erste Padel-Verein im Raum Freiburg: die Heimat für Padel in Freiburg, offen für alle Spielstärken und Altersgruppen.";

const { title, description = DEFAULT_DESCRIPTION } = Astro.props;

const pageTitle = `${title || "Willkommen"} | ${SITE_NAME}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = new URL("/opengraph.jpg", Astro.site).toString();
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1f1f1f" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <SEO
      title={pageTitle}
      description={description}
      canonical={canonicalURL}
      twitter={{
        creator: "@padelclubfreiburg",
        site: "@padelclubfreiburg",
        card: "summary_large_image",
      }}
      openGraph={{
        basic: {
          url: canonicalURL,
          type: "website",
          title: pageTitle,
          image: ogImage,
        },
        optional: {
          siteName: SITE_NAME,
          locale: "de_DE",
          description,
        },
        image: {
          alt: "Logo des Padel Club Freiburg e.V. mit dem Satz: Die Heimat für Padel in Freiburg",
          width: 1200,
          height: 630,
          type: "image/jpeg",
        },
      }}
    />
    <slot name="head" />
  </head>
  <body class="bg-white font-sans text-neutraldark antialiased">
    <a
      href="#inhalt"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-sm focus:bg-neutraldark focus:px-4 focus:py-3 focus:text-white">
      Zum Inhalt springen
    </a>
    <Navbar />
    <main id="inhalt">
      <slot />
    </main>
    <Footer />
    <style is:global>
      /* Improve Page speed */
      /* https://css-tricks.com/almanac/properties/c/content-visibility/ */
      img {
        content-visibility: auto;
      }
    </style>
  </body>
</html>
